# 飞书每日班表推送 —— 环境变量示例
# 本地调试：复制为 .env 并填写后，用 `node --env-file=.env scripts/push-schedule.js` 运行。
# 线上：把下面的值配置到 GitHub 仓库的 Secrets / Variables（见 README）。

# ===== 必填 =====
# 飞书自建应用凭证（用于读取多维表格），在「开发者后台 -> 应用 -> 凭证与基础信息」获取
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# 群机器人 Webhook 地址（群设置 -> 群机器人 -> 添加自定义机器人）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx

# ===== 可选 =====
# 机器人若开启了「签名校验」，填这里的密钥；否则留空
FEISHU_WEBHOOK_SECRET=

# 多维表格定位（默认值已内置为当前班表，通常无需修改）
FEISHU_APP_TOKEN=MZn6bicQ0aLTios6HWacdm20nZg
FEISHU_TABLE_ID=tblooJsiNzeJ5dLj
# 指定视图（会套用视图里的筛选/排序）；留空则读取整表后自行按日期筛选
FEISHU_VIEW_ID=

# 字段名（需与表格列名完全一致）
FEISHU_DATE_FIELD=日期
FEISHU_WEEKDAY_FIELD=星期
# 要展示的角色列，逗号分隔；留空 = 自动展示除「日期/星期」外的所有非空列
# 例：FEISHU_ROLE_FIELDS=早班课程顾问,早班教练,晚班教练
FEISHU_ROLE_FIELDS=

# 时区，决定「今天」是哪一天
FEISHU_TIMEZONE=Asia/Shanghai
# 今日无排班时是否仍推送一条提示（true/false）
FEISHU_PUSH_WHEN_EMPTY=true
