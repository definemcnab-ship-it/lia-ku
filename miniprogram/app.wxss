/* 全局设计令牌 */
page {
  --color-primary: #8f8779;
  --color-primary-container: #a89f90;
  --color-on-primary: #f7f5f0;
  --color-primary-fixed: #ece8e0;
  --color-surface: #ffffff;
  --color-surface-container: #f4f1ec;
  --color-surface-container-low: #faf8f5;
  --color-surface-container-lowest: #ffffff;
  --color-surface-variant: #eeeae3;
  --color-on-surface: #3f3a32;
  --color-on-surface-variant: #6e675b;
  --color-outline: #9e9688;
  --color-outline-variant: #dcd6cc;
  --color-background: #fbfaf8;
  --color-ink: #2b2720;
  --color-gold: #c08a7d;
  --color-gold-soft: #d8b0a4;
  --color-error: #a85c47;

  background-color: var(--color-background);
  color: var(--color-on-surface);
  font-family: -apple-system, PingFang SC, Microsoft YaHei, sans-serif;
  font-size: 14px;
  line-height: 1.5;
  box-sizing: border-box;
}

/* 通用工具类 */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.items-center { align-items: center; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.flex-1 { flex: 1; }
.w-full { width: 100%; }
.text-center { text-align: center; }
.relative { position: relative; }
.absolute { position: absolute; }

/* 字体 */
.font-headline {
  font-family: "Songti SC", Georgia, serif;
  font-weight: 300;
}
.font-label {
  font-family: -apple-system, PingFang SC, sans-serif;
}

/* 阴影 */
.shadow-soft {
  box-shadow: 0 1px 2px rgba(43,39,32,0.04), 0 8px 24px rgba(43,39,32,0.06);
}
.shadow-soft-lg {
  box-shadow: 0 2px 4px rgba(43,39,32,0.04), 0 16px 48px rgba(43,39,32,0.08);
}
