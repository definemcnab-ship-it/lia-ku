<view class="page">
  <!-- Navbar -->
  <view class="navbar">
    <view class="nav-back" bindtap="navBack">
      <mp-icon name="arrow_back" size="22" color="#2b2720" />
    </view>
    <view class="nav-titles">
      <text class="page-title">斯俪圈子</text>
      <text class="page-subtitle">与姐妹们分享蜕变之路</text>
    </view>
  </view>

  <!-- Tab bar -->
  <view class="tab-bar-wrap">
    <view class="tab-bar">
      <view
        class="tab-pill {{activeTab === index ? 'tab-pill-active' : ''}}"
        wx:for="{{tabs}}"
        wx:key="index"
        data-idx="{{index}}"
        bindtap="switchTab"
      >
        <text class="tab-text {{activeTab === index ? 'tab-text-active' : ''}}">{{item}}</text>
      </view>
    </view>
  </view>

  <scroll-view class="scroll-area" scroll-y>
    <!-- Post list -->
    <view class="section">
      <view class="post-card card" wx:for="{{posts}}" wx:key="id">
        <!-- Post header -->
        <view class="post-header">
          <view class="avatar-circle">
            <text class="avatar-emoji">{{item.avatar}}</text>
          </view>
          <view class="post-meta">
            <text class="post-name">{{item.name}}</text>
            <text class="post-time">{{item.time}}</text>
          </view>
          <view class="tag-badge">
            <text class="tag-text">{{item.tag}}</text>
          </view>
        </view>

        <!-- Post content -->
        <text class="post-content">{{item.content}}</text>

        <!-- Post footer -->
        <view class="post-footer">
          <view class="post-action" data-id="{{item.id}}" bindtap="likePost">
            <mp-icon name="thumb_up" size="32" color="#8f8779" />
            <text class="action-count">{{item.likes}}</text>
          </view>
          <view class="post-action">
            <mp-icon name="chat_bubble" size="32" color="#8f8779" />
            <text class="action-count">{{item.comments}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="bottom-spacer"></view>
  </scroll-view>

  <!-- Floating post button -->
  <view class="fab" bindtap="openComposer">
    <mp-icon name="add" size="48" color="#ffffff" />
  </view>

  <!-- 发表动态 -->
  <view wx:if="{{composerOpen}}" class="composer-mask" bindtap="closeComposer">
    <view class="composer-sheet" catchtap="noop">
      <view class="composer-head">
        <text class="composer-cancel" bindtap="closeComposer">取消</text>
        <text class="composer-title">发表动态</text>
        <text class="composer-submit" bindtap="submitPost">发布</text>
      </view>
      <textarea
        class="composer-input"
        placeholder="分享你的蜕变之路、训练心得或想问的问题…"
        placeholder-class="composer-ph"
        value="{{draft}}"
        bindinput="onDraftInput"
        maxlength="500"
        auto-height
        focus
      />
      <view class="composer-tags">
        <view
          class="composer-tag {{draftTag === item ? 'composer-tag-active' : ''}}"
          wx:for="{{tagOptions}}"
          wx:key="*this"
          data-tag="{{item}}"
          bindtap="selectDraftTag"
        >
          <text>{{item}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
