<view class="page">
  <!-- 顶部导航 -->
  <view class="navbar" style="padding-top: {{statusBarHeight}}px">
    <view class="navbar-inner">
      <view class="nav-left" bindtap="goProfile">
        <view class="avatar">
          <text class="avatar-icon">👤</text>
        </view>
        <text class="brand">Slique</text>
      </view>
      <view class="nav-right">
        <text class="notify-icon">🔔</text>
      </view>
    </view>
  </view>

  <!-- 欢迎语 -->
  <view class="greeting">
    <text class="greeting-sub">SLIQUE · 优雅体态</text>
    <text class="greeting-title font-headline">{{greetingText}}</text>
    <text class="greeting-body">今天也要保持优雅体态哦 ✨</text>
  </view>

  <!-- Banner 轮播 -->
  <swiper class="banner-swiper" circular autoplay interval="3000" indicator-dots="{{false}}"
    current="{{bannerIdx}}" bindchange="onBannerChange">
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <view class="banner-slide {{item.bg}}" bindtap="navTo" data-url="{{item.to}}">
        <view class="banner-deco-circle"></view>
        <view class="banner-content">
          <view class="banner-text">
            <text class="banner-tag">{{item.label}}</text>
            <text class="banner-title font-headline">{{item.title}}</text>
            <text class="banner-sub">{{item.sub}}</text>
            <text class="banner-cta">{{item.cta}} →</text>
          </view>
          <view class="banner-icon-wrap">
            <text class="banner-icon-emoji">{{item.emoji}}</text>
          </view>
        </view>
        <!-- 指示器 -->
        <view class="banner-dots">
          <view wx:for="{{banners}}" wx:for-item="dot" wx:key="index"
            class="dot {{index === bannerIdx ? 'dot-active' : ''}}"></view>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <!-- 快捷入口 -->
  <view class="shortcuts">
    <view class="shortcut" wx:for="{{shortcuts}}" wx:key="to" bindtap="navTo" data-url="{{item.to}}">
      <view class="shortcut-icon-wrap">
        <text class="shortcut-emoji">{{item.emoji}}</text>
      </view>
      <text class="shortcut-label">{{item.label}}</text>
    </view>
  </view>

  <!-- 体态分概览 -->
  <view class="section">
    <view class="score-card shadow-soft" bindtap="navTo" data-url="/pages/report/report">
      <view class="score-left">
        <text class="score-label-text">当前体态分</text>
        <view class="score-num-row">
          <text class="score-num">{{postureScore}}</text>
          <text class="score-denom">/ 100</text>
        </view>
        <view class="score-diff">
          <text class="score-diff-icon">↗</text>
          <text class="score-diff-text">{{diffText}}</text>
        </view>
      </view>
      <view class="score-ring-wrap">
        <!-- 用canvas或简化ring -->
        <view class="ring-outer">
          <view class="ring-icon">🧘</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 今日训练计划 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title font-headline">今日训练计划</text>
      <text class="section-more" bindtap="navTo" data-url="/pages/training/training">查看全部</text>
    </view>
    <view class="training-card shadow-soft" bindtap="navTo" data-url="/pages/training/training">
      <view class="training-visual">
        <view class="training-icon-ring">
          <text class="training-icon-emoji">🧘</text>
        </view>
        <view class="training-overlay">
          <text class="training-course-name font-headline">天鹅颈塑形课</text>
          <text class="training-course-sub">8周挺拔如模特 · 15分钟 · 4个动作</text>
        </view>
      </view>
      <view class="training-footer">
        <view class="training-progress">
          <view class="progress-bar">
            <view class="progress-fill" style="width: {{trainedToday ? '100' : '0'}}%"></view>
          </view>
          <text class="progress-text">{{trainedToday ? '今日已完成 ✓' : '今日进度 0% · 待开始'}}</text>
        </view>
        <view class="play-btn" catchtap="startTraining">
          <text class="play-icon">{{trainedToday ? '✓' : '▶'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 探索功能 -->
  <view class="section">
    <text class="section-title font-headline">探索功能</text>
    <view class="categories-grid">
      <view class="cat-card {{item.bg}}" wx:for="{{categories}}" wx:key="to"
        bindtap="navTo" data-url="{{item.to}}">
        <view class="cat-top">
          <view class="cat-icon-wrap">
            <text class="cat-emoji">{{item.emoji}}</text>
          </view>
        </view>
        <view class="cat-bottom">
          <text class="cat-title">{{item.title}}</text>
          <text class="cat-desc">{{item.desc}}</text>
          <text class="cat-cta">查看 →</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部占位（TabBar 高度） -->
  <view style="height: 120rpx"></view>
</view>
