.page {
  min-height: 100vh;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx;
  box-sizing: border-box;
}

/* 插图 */
.illus-wrap {
  width: 100%;
  display: flex;
  justify-content: center;
  padding-top: 60rpx;
  margin-bottom: 48rpx;
}
.illus {
  width: 600rpx;
  height: 600rpx;
}

/* 标题 */
.title-wrap {
  text-align: center;
  margin-bottom: 80rpx;
  padding: 0 16rpx;
}
.title {
  display: block;
  font-family: NotoSerifSC, "Noto Serif SC", "Songti SC", Georgia, serif;
  font-size: 56rpx;
  color: #2b2720;
  font-weight: 300;
  line-height: 1.4;
  margin-bottom: 20rpx;
  letter-spacing: 4rpx;
}
.subtitle {
  display: block;
  font-size: 26rpx;
  color: #b0a898;
  letter-spacing: 6rpx;
}

/* 按钮 */
.buttons {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 40rpx;
}
.btn-phone {
  width: 100%;
  height: 96rpx;
  background: #2b2720;
  color: #f7f5f0;
  border-radius: 48rpx;
  font-size: 30rpx;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  border: none;
}
.btn-wechat {
  width: 100%;
  height: 96rpx;
  background: #ffffff;
  color: #3f3a32;
  border-radius: 48rpx;
  font-size: 30rpx;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  border: 1.5rpx solid #dcd6cc;
}
.wechat-logo {
  width: 44rpx; height: 44rpx; border-radius: 50%;
  background: #07C160;
  display: flex; align-items: center; justify-content: center;
}
.wechat-text { font-size: 24rpx; color: #fff; font-weight: bold; }

.skip-link {
  text-align: center;
  font-size: 26rpx;
  color: #b0a898;
  letter-spacing: 2rpx;
  margin-top: 12rpx;
}

/* 协议 */
.agreement {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 8rpx;
  padding: 0 8rpx;
  margin-top: auto;
  padding-bottom: 60rpx;
}
.agree-text { font-size: 22rpx; color: #9e9688; line-height: 1.7; flex: 1; }
.agree-link { color: #8f8779; }
.shake { animation: shake 0.5s ease; }
@keyframes shake {
  0%,100% { transform: translateX(0); }
  20%,60% { transform: translateX(-8rpx); }
  40%,80% { transform: translateX(8rpx); }
}

/* 手机号抽屉 */
.sheet-mask {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0); z-index: 200;
  pointer-events: none; transition: background 0.3s;
}
.sheet-mask.visible {
  background: rgba(0,0,0,0.5); pointer-events: auto;
}
.sheet {
  position: absolute; bottom: 0; left: 0; right: 0;
  background: #ffffff; border-radius: 48rpx 48rpx 0 0;
  padding: 32rpx 48rpx 60rpx;
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(0.25,0.46,0.45,0.94);
}
.sheet.sheet-up { transform: translateY(0); }
.sheet-handle {
  width: 80rpx; height: 8rpx; background: #dcd6cc;
  border-radius: 4rpx; margin: 0 auto 40rpx;
}
.sheet-title { font-size: 40rpx; color: #2b2720; display: block; margin-bottom: 8rpx; }
.sheet-hint { font-size: 26rpx; color: #9e9688; display: block; margin-bottom: 40rpx; }
.input-row {
  display: flex; align-items: center;
  background: #f4f1ec; border-radius: 20rpx;
  padding: 0 32rpx; height: 100rpx; margin-bottom: 24rpx; gap: 16rpx;
}
.phone-prefix { font-size: 30rpx; color: #6e675b; }
.input { flex: 1; font-size: 30rpx; color: #3f3a32; background: transparent; }
.input-placeholder { color: #9e9688; }
.send-code { font-size: 26rpx; color: #dcd6cc; }
.send-code.active { color: #8f8779; }
.btn-login { margin-top: 16rpx; }
.disabled { opacity: 0.4; }
