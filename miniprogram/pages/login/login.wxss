.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 上半品牌区 */
.hero {
  height: 62vh;
  background: linear-gradient(135deg, #d8cfbf 0%, #c8bfaf 50%, #a89f90 100%);
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 0 60rpx 80rpx;
  overflow: hidden;
}

.hero-illus {
  position: absolute;
  left: 50%;
  top: 48rpx;
  transform: translateX(-50%);
  width: 480rpx;
  height: 480rpx;
}

.hero-deco-circle1 {
  position: absolute;
  top: -120rpx;
  right: -120rpx;
  width: 480rpx;
  height: 480rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.10);
}
.hero-deco-circle2 {
  position: absolute;
  top: 60rpx;
  left: -120rpx;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.07);
}

.hero-icon-wrap {
  position: absolute;
  top: 28%;
  left: 50%;
  transform: translateX(-50%);
}
.hero-icon-bg {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  background: rgba(255,255,255,0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}
.hero-icon-text {
  font-size: 80rpx;
}

.hero-text { display: flex; flex-direction: column; }
.hero-sub {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}
.hero-title1 {
  font-family: "Songti SC", Georgia, serif;
  font-size: 68rpx;
  color: #ffffff;
  font-weight: 300;
  line-height: 1.2;
}
.hero-title2 {
  font-family: "Songti SC", Georgia, serif;
  font-size: 84rpx;
  color: #ffffff;
  font-weight: 400;
  line-height: 1.2;
}
.hero-desc {
  font-size: 28rpx;
  color: rgba(255,255,255,0.75);
  margin-top: 12rpx;
}

.skip-btn {
  position: absolute;
  top: 90rpx;
  right: 40rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 30rpx;
  padding: 12rpx 28rpx;
}
.skip-text { font-size: 26rpx; color: rgba(255,255,255,0.8); }

/* 下半白卡 */
.card {
  flex: 1;
  background: #ffffff;
  border-radius: 64rpx 64rpx 0 0;
  margin-top: -48rpx;
  padding: 60rpx 48rpx 40rpx;
  display: flex;
  flex-direction: column;
}

.card-title {
  font-size: 52rpx;
  color: #2b2720;
  font-weight: 300;
}
.card-sub {
  font-size: 26rpx;
  color: #6e675b;
  margin-top: 8rpx;
  margin-bottom: 56rpx;
}

.btn-primary {
  width: 100%;
  height: 100rpx;
  background: #8f8779;
  color: #f7f5f0;
  border-radius: 24rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  border: none;
  box-shadow: 0 8px 24px rgba(143,135,121,0.25);
}
.btn-secondary {
  width: 100%;
  height: 100rpx;
  background: #f4f1ec;
  color: #3f3a32;
  border-radius: 24rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  border: none;
}
.btn-icon { font-size: 36rpx; }

/* 协议 */
.agreement {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 8rpx;
  margin-top: auto;
  padding-top: 40rpx;
}
.agree-text { font-size: 22rpx; color: #6e675b; line-height: 1.6; flex: 1; }
.agree-link { color: #8f8779; }
.shake { animation: shake 0.5s ease; }
@keyframes shake {
  0%,100% { transform: translateX(0); }
  20%,60% { transform: translateX(-8rpx); }
  40%,80% { transform: translateX(8rpx); }
}

/* 手机号抽屉 */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0);
  z-index: 200;
  pointer-events: none;
  transition: background 0.3s;
}
.sheet-mask.visible {
  background: rgba(0,0,0,0.5);
  pointer-events: auto;
}
.sheet {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  border-radius: 48rpx 48rpx 0 0;
  padding: 32rpx 48rpx 60rpx;
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(0.25,0.46,0.45,0.94);
}
.sheet.sheet-up { transform: translateY(0); }
.sheet-handle {
  width: 80rpx;
  height: 8rpx;
  background: #dcd6cc;
  border-radius: 4rpx;
  margin: 0 auto 40rpx;
}
.sheet-title { font-size: 40rpx; color: #2b2720; display: block; margin-bottom: 8rpx; }
.sheet-hint { font-size: 26rpx; color: #9e9688; display: block; margin-bottom: 40rpx; }

.input-row {
  display: flex;
  align-items: center;
  background: #f4f1ec;
  border-radius: 20rpx;
  padding: 0 32rpx;
  height: 100rpx;
  margin-bottom: 24rpx;
  gap: 16rpx;
}
.phone-prefix { font-size: 30rpx; color: #6e675b; }
.input { flex: 1; font-size: 30rpx; color: #3f3a32; background: transparent; }
.input-placeholder { color: #9e9688; }
.send-code { font-size: 26rpx; color: #dcd6cc; }
.send-code.active { color: #8f8779; }
.btn-login { margin-top: 16rpx; }
.disabled { opacity: 0.4; }
