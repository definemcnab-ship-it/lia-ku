<view class="page">
  <!-- 顶部进度条 + 跳过 -->
  <view class="header">
    <view class="dots">
      <view wx:for="{{4}}" wx:key="index"
        class="dot {{index === step ? 'dot-active' : ''}}"></view>
    </view>
    <text class="skip" bindtap="skipToHome">跳过</text>
  </view>

  <!-- Step 0：品牌介绍 -->
  <view class="main">
    <view class="slide {{step === 0 ? 'visible' : 'hidden'}}">
      <view class="slide-icon-wrap">
        <mp-icon name="self_improvement" size="72" color="#8f8779" />
      </view>
      <text class="slide-title">松而不塌</text>
      <text class="slide-body">专注女性体态，让身体重新立住。</text>
    </view>

    <!-- Step 1：功能介绍 -->
    <view class="slide {{step === 1 ? 'visible' : 'hidden'}}">
      <view class="slide-icon-wrap slide-icon-wrap2">
        <mp-icon name="auto_awesome" size="72" color="#8f8779" />
      </view>
      <text class="slide-title">3 分钟，建立你的体态档案</text>
      <text class="slide-body">体态档案 → 专属养成计划 → 肉眼可见的改变。</text>
    </view>

    <!-- Step 2：偏好设置 -->
    <view class="slide slide-prefs {{step === 2 ? 'visible' : 'hidden'}}">
      <text class="prefs-title">完善基础信息</text>
      <text class="prefs-sub">用于体态分对照标准，可稍后在设置中补充。</text>
      <text class="prefs-label">训练场景（可多选）</text>
      <view class="chips">
        <view wx:for="{{scenes}}" wx:key="item"
          class="chip {{sceneSelected[item] ? 'chip-active' : ''}}"
          bindtap="toggleScene" data-val="{{item}}">
          <text>{{item}}</text>
        </view>
      </view>
      <text class="prefs-label">可用器械（可多选）</text>
      <view class="chips">
        <view wx:for="{{gears}}" wx:key="item"
          class="chip {{gearSelected[item] ? 'chip-active' : ''}}"
          bindtap="toggleGear" data-val="{{item}}">
          <text>{{item}}</text>
        </view>
      </view>
    </view>

    <!-- Step 3：体态档案引导 -->
    <view class="slide {{step === 3 ? 'visible' : 'hidden'}}">
      <view class="slide-icon-wrap slide-icon-wrap3">
        <mp-icon name="photo_camera" size="64" color="#8f8779" />
      </view>
      <text class="slide-title">建立体态档案</text>
      <text class="slide-body">拍摄正面 / 侧面 / 背面 3 张照片，即可生成你的「体态档案」与挺拔度参考。</text>
      <view class="privacy-tip">
        <mp-icon name="lock" size="20" color="#8f8779" />
        <text class="privacy-text">照片加密存储，仅用于体态分析，可随时删除。</text>
      </view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="footer">
    <button class="btn-primary" bindtap="nextStep">
      {{step === 3 ? '建立档案' : '继续'}}
    </button>
    <button wx:if="{{step === 3}}" class="btn-ghost" bindtap="skipToHome">稍后再说</button>
  </view>
</view>
