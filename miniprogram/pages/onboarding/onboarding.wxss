.page {
  min-height: 100vh;
  background: #ffffff;
  display: flex;
  flex-direction: column;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 80rpx 48rpx 32rpx;
}
.dots { display: flex; gap: 12rpx; }
.dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: #ece8e0; transition: all 0.3s;
}
.dot-active { width: 48rpx; border-radius: 6rpx; background: #8f8779; }
.skip { font-size: 28rpx; color: #9e9688; }

.main {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 48rpx;
  position: relative;
}

.slide {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.visible { display: flex; }
.hidden { display: none; }

.slide-icon-wrap {
  width: 240rpx; height: 240rpx; border-radius: 50%;
  background: #ece8e0;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 60rpx;
}
.slide-icon-wrap2 { background: #ece8e0; }
.slide-icon-wrap3 { background: #ece8e0; border-radius: 40rpx; }
.slide-emoji { font-size: 100rpx; }

.slide-title {
  font-family: "Songti SC", Georgia, serif;
  font-size: 52rpx; color: #2b2720; font-weight: 400;
  display: block; margin-bottom: 24rpx; line-height: 1.3;
}
.slide-body {
  font-size: 30rpx; color: #6e675b; line-height: 1.8;
  display: block;
}

/* 偏好步骤 */
.slide-prefs { align-items: flex-start; text-align: left; }
.prefs-title {
  font-family: "Songti SC", Georgia, serif;
  font-size: 48rpx; color: #2b2720; display: block; margin-bottom: 12rpx;
}
.prefs-sub { font-size: 26rpx; color: #9e9688; display: block; margin-bottom: 48rpx; }
.prefs-label { font-size: 28rpx; color: #3f3a32; display: block; margin-bottom: 20rpx; font-weight: 500; }
.chips { display: flex; flex-wrap: wrap; gap: 20rpx; margin-bottom: 48rpx; }
.chip {
  padding: 16rpx 40rpx; border-radius: 60rpx;
  background: #f4f1ec; color: #6e675b;
  font-size: 28rpx; border: 2rpx solid #dcd6cc;
}
.chip-active { background: #8f8779; color: #f7f5f0; border-color: #8f8779; }

/* 隐私提示 */
.privacy-tip {
  display: flex; align-items: flex-start; gap: 16rpx;
  background: #f4f1ec; border-radius: 20rpx;
  padding: 24rpx 32rpx; margin-top: 40rpx; width: 100%;
  box-sizing: border-box;
}
.privacy-icon { font-size: 36rpx; flex-shrink: 0; }
.privacy-text { font-size: 26rpx; color: #6e675b; line-height: 1.6; flex: 1; }

/* 底部 */
.footer { padding: 0 48rpx 80rpx; }
.btn-primary {
  width: 100%; height: 100rpx;
  background: #8f8779; color: #f7f5f0;
  border-radius: 24rpx; font-size: 32rpx;
  display: flex; align-items: center; justify-content: center;
  border: none; margin-bottom: 20rpx;
}
.btn-ghost {
  width: 100%; height: 80rpx;
  background: transparent; color: #9e9688;
  font-size: 28rpx; border: none;
  display: flex; align-items: center; justify-content: center;
}
