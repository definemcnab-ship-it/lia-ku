<view class="page">

  <!-- Back nav -->
  <view class="navbar">
    <view class="back-btn" bindtap="goTraining">
      <text class="back-icon">‹</text>
    </view>
    <view class="nav-title-wrap">
      <text class="nav-title">{{courseN || '训练'}}</text>
      <text wx:if="{{sceneTag}}" class="nav-scene-tag">{{sceneTag}}</text>
    </view>
    <view class="nav-spacer"></view>
  </view>

  <!-- 总进度条 -->
  <view class="progress-bar-wrap">
    <view class="progress-bar-track">
      <view class="progress-bar-fill" style="width:{{moves.length ? (currentIdx / moves.length * 100) : 0}}%"></view>
    </view>
    <text class="progress-label">第 {{currentIdx + 1}} / {{moves.length}} 个动作 · 约 {{totalMinutes}} 分钟</text>
  </view>

  <!-- Move visual card -->
  <view class="visual-card" wx:if="{{moves.length > 0}}">
    <video wx:if="{{moves[currentIdx] && moves[currentIdx].video}}"
      class="visual-video" src="{{moves[currentIdx].video}}"
      autoplay loop muted object-fit="cover" show-center-play-btn="{{false}}" controls="{{false}}" />
    <channel-video wx:elif="{{moves[currentIdx] && moves[currentIdx].feedId}}"
      class="visual-video" feed-id="{{moves[currentIdx].feedId}}"
      finder-user-name="{{moves[currentIdx].finderUserName}}"
      autoplay loop object-fit="cover" />
    <image wx:elif="{{moves[currentIdx]}}"
      class="{{moves[currentIdx].poseMode === 'cover' ? 'visual-photo' : 'visual-pose'}}"
      src="{{moves[currentIdx].pose}}"
      mode="{{moves[currentIdx].poseMode === 'cover' ? 'aspectFill' : 'aspectFit'}}" />
    <view class="visual-name-bar" wx:if="{{moves[currentIdx]}}">
      <text class="visual-name">{{moves[currentIdx].name}}</text>
      <text wx:if="{{moves[currentIdx].reps}}" class="visual-reps">{{moves[currentIdx].reps}}</text>
    </view>
  </view>

  <!-- 动作要点 -->
  <view wx:if="{{moves[currentIdx] && moves[currentIdx].tip}}" class="tip-row">
    <mp-icon name="lightbulb" size="16" color="#c08a7d" />
    <text class="tip-text">{{moves[currentIdx].tip}}</text>
  </view>

  <!-- Progress dots -->
  <view class="dots-row">
    <view
      wx:for="{{moves}}"
      wx:key="index"
      class="dot {{index === currentIdx ? 'dot-active' : ''}} {{index < currentIdx ? 'dot-done' : ''}}"
    ></view>
  </view>

  <!-- 计时区 -->
  <view class="timer-wrap">
    <view wx:if="{{resting}}" class="timer-rest-block">
      <text class="timer-rest-label">组间休息</text>
      <view class="timer-num-row">
        <text class="timer-num">{{restLeft}}</text>
        <text class="timer-unit">秒</text>
      </view>
      <text class="set-hint">完成第 {{currentSet - 1}} 组，准备第 {{currentSet}} 组</text>
      <view class="skip-btn" bindtap="skipRest">
        <text class="skip-text">跳过休息 ›</text>
      </view>
    </view>
    <view wx:else class="timer-main-block">
      <view class="timer-num-row">
        <text class="timer-num">{{timeLeft}}</text>
        <text class="timer-unit">秒</text>
      </view>
      <text wx:if="{{totalSets > 1}}" class="set-hint">第 {{currentSet}} / {{totalSets}} 组</text>
    </view>
  </view>

  <!-- 目标肌群 -->
  <view class="muscle-row" wx:if="{{moves[currentIdx].muscles.length}}">
    <text class="muscle-phase">{{moves[currentIdx].phaseLabel}}</text>
    <text class="muscle-chip" wx:for="{{moves[currentIdx].muscles}}" wx:key="*this">{{item}}</text>
  </view>

  <!-- Move description -->
  <text wx:if="{{moves[currentIdx]}}" class="move-desc">{{moves[currentIdx].desc}}</text>

  <!-- Controls -->
  <view class="controls-row">
    <view class="ctrl-btn ctrl-side" bindtap="prevMove">
      <mp-icon name="skip_previous" size="28" color="#8f8779" />
    </view>
    <view class="ctrl-btn ctrl-play {{resting ? 'ctrl-play-muted' : ''}}" bindtap="togglePlay">
      <mp-icon name="{{playing ? 'pause' : 'play_arrow'}}" size="44" color="#fff" />
    </view>
    <view class="ctrl-btn ctrl-side" bindtap="nextMove">
      <mp-icon name="skip_next" size="28" color="#8f8779" />
    </view>
  </view>

  <!-- Step list -->
  <view class="step-list">
    <view
      wx:for="{{moves}}"
      wx:key="index"
      class="step-row {{index === currentIdx ? 'step-active' : 'step-muted'}} {{index < currentIdx ? 'step-done' : ''}}"
    >
      <view class="step-num-wrap">
        <mp-icon wx:if="{{index < currentIdx}}" name="check" size="16" color="#c08a7d" />
        <text wx:else class="step-num">{{index + 1}}</text>
      </view>
      <view class="step-info">
        <text class="step-name">{{item.name}}</text>
        <text wx:if="{{item.sets > 1}}" class="step-sets">{{item.sets}} 组</text>
      </view>
      <text class="step-dur">{{item.duration}}秒</text>
    </view>
  </view>

  <!-- Completion overlay -->
  <view class="done-backdrop" wx:if="{{done}}">
    <view class="done-card">
      <view class="done-check">
        <mp-icon name="check_circle" size="64" color="#c08a7d" />
      </view>
      <text class="done-title">训练完成！</text>
      <text class="done-sub">今日打卡成功 · 共 {{totalMinutes}} 分钟</text>
      <text class="done-week" wx:if="{{weekCount > 0}}">本周第 {{weekCount}} 次训练</text>

      <!-- 新解锁成就 -->
      <view class="badge-pop" wx:if="{{newBadges.length}}">
        <text class="badge-pop-title">解锁新成就</text>
        <view class="badge-chip" wx:for="{{newBadges}}" wx:key="id">
          <view class="badge-chip-icon">
            <mp-icon name="{{item.icon}}" size="22" color="#c08a7d" />
          </view>
          <view class="badge-chip-info">
            <text class="badge-name">{{item.name}}</text>
            <text class="badge-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>

      <!-- 够得着的下一步 -->
      <text class="badge-next" wx:if="{{nextBadgeHint}}">{{nextBadgeHint}}</text>

      <view class="done-actions">
        <view class="done-btn done-btn-outline" bindtap="goTraining">
          <text>返回训练</text>
        </view>
        <view class="done-btn done-btn-fill" bindtap="goProgress">
          <text>查看进步</text>
        </view>
      </view>
    </view>
  </view>

</view>
