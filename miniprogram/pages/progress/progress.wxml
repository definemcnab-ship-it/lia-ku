<view class="page">

  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title font-headline">进步追踪</text>
    <view class="header-icon-wrap">
      <mp-icon name="trending_up" size="22" color="#8f8779" />
    </view>
  </view>

  <!-- 评分卡片 -->
  <view class="score-card">
    <view class="score-main">
      <text class="score-number font-headline">{{postureScore}}</text>
      <view class="score-meta">
        <text class="score-label">体态评分</text>
        <text class="score-diff">较上次提升 4 分 ↑</text>
      </view>
    </view>
    <view class="score-ring">
      <mp-icon name="accessibility_new" size="44" color="#c08a7d" />
    </view>
  </view>

  <!-- 本周趋势 -->
  <view class="section">
    <text class="section-title font-headline">本周趋势</text>
    <view class="chart-card">
      <view class="bar-chart">
        <view
          wx:for="{{weekData}}"
          wx:key="index"
          class="bar-col"
        >
          <text class="bar-value">{{item}}</text>
          <view class="bar-track">
            <view
              class="bar-fill {{index === 6 ? 'bar-fill-today' : ''}}"
              style="height: {{(item - 50) * 4}}rpx;"
            ></view>
          </view>
          <text class="bar-label">{{weekLabels[index]}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 统计数据行 -->
  <view class="stats-row">
    <view class="stat-card">
      <view class="stat-icon-wrap">
        <mp-icon name="calendar_month" size="24" color="#c08a7d" />
      </view>
      <text class="stat-value font-headline">{{checkInDays}}天</text>
      <text class="stat-label">打卡天数</text>
    </view>
    <view class="stat-card">
      <view class="stat-icon-wrap">
        <mp-icon name="fitness_center" size="24" color="#8f8779" />
      </view>
      <text class="stat-value font-headline">3次</text>
      <text class="stat-label">本周训练</text>
    </view>
  </view>

  <!-- 成就里程碑 -->
  <view class="section">
    <text class="section-title font-headline">成就里程碑</text>
    <view class="milestones-card">
      <view
        wx:for="{{milestones}}"
        wx:key="label"
        class="milestone-row {{!item.done ? 'milestone-undone' : ''}}"
      >
        <view class="milestone-icon-wrap {{item.done ? 'icon-wrap-done' : 'icon-wrap-undone'}}">
          <mp-icon
            name="{{item.icon}}"
            size="20"
            color="{{item.done ? '#c08a7d' : '#b8b0a4'}}"
          />
        </view>
        <text class="milestone-label {{item.done ? 'label-done' : 'label-undone'}}">{{item.label}}</text>
        <view class="milestone-status">
          <text class="status-text {{item.done ? 'status-done' : 'status-pending'}}">{{item.done ? '已达成' : '进行中'}}</text>
        </view>
      </view>
    </view>
  </view>

  <view style="height: 140rpx"></view>
</view>
