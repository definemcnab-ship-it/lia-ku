<view class="page">

  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title font-headline">进步追踪</text>
    <view class="header-icon-wrap">
      <mp-icon name="trending_up" size="22" color="#8f8779" />
    </view>
  </view>

  <!-- 评分卡片 -->
  <view class="score-card">
    <view class="score-main">
      <text class="score-number font-headline">{{postureScore}}</text>
      <view class="score-meta">
        <text class="score-label">挺拔度</text>
        <text class="score-diff">{{diffText}} {{diffUp ? '↑' : '↓'}}</text>
      </view>
    </view>
    <view class="score-ring">
      <mp-icon name="accessibility_new" size="44" color="#c08a7d" />
    </view>
  </view>

  <!-- 近七天评分趋势 -->
  <view class="section">
    <text class="section-title font-headline">近七天趋势</text>
    <view class="chart-card">
      <view class="bar-chart">
        <view
          wx:for="{{bars}}"
          wx:key="index"
          class="bar-col"
        >
          <text class="bar-value">{{item.value}}</text>
          <view class="bar-track">
            <view
              class="bar-fill {{item.isToday ? 'bar-fill-today' : ''}}"
              style="height: {{item.h}}rpx;"
            ></view>
          </view>
          <text class="bar-label">{{item.label}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 统计数据行 -->
  <view class="stats-row">
    <view class="stat-card">
      <view class="stat-icon-wrap">
        <mp-icon name="calendar_month" size="24" color="#c08a7d" />
      </view>
      <text class="stat-value font-headline">{{checkInDays}}天</text>
      <text class="stat-label">累计打卡</text>
    </view>
    <view class="stat-card">
      <view class="stat-icon-wrap">
        <mp-icon name="fitness_center" size="24" color="#8f8779" />
      </view>
      <text class="stat-value font-headline">{{weekSessions}}次</text>
      <text class="stat-label">本周训练</text>
    </view>
    <view class="stat-card">
      <view class="stat-icon-wrap">
        <mp-icon name="auto_awesome" size="24" color="#8d7dc0" />
      </view>
      <text class="stat-value font-headline">{{totalSessions}}次</text>
      <text class="stat-label">累计训练</text>
    </view>
  </view>

  <!-- 成就里程碑 -->
  <view class="section">
    <text class="section-title font-headline">成就里程碑</text>
    <view class="milestones-card">
      <view
        wx:for="{{milestones}}"
        wx:key="label"
        class="milestone-row {{!item.done ? 'milestone-undone' : ''}}"
      >
        <view class="milestone-icon-wrap {{item.done ? 'icon-wrap-done' : 'icon-wrap-undone'}}">
          <mp-icon
            name="{{item.icon}}"
            size="20"
            color="{{item.done ? '#c08a7d' : '#b8b0a4'}}"
          />
        </view>
        <text class="milestone-label {{item.done ? 'label-done' : 'label-undone'}}">{{item.label}}</text>
        <view class="milestone-status">
          <text class="status-text {{item.done ? 'status-done' : 'status-pending'}}">{{item.done ? '已达成' : '进行中'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 本月打卡日历 -->
  <view class="section">
    <text class="section-title font-headline">{{monthLabel}}打卡日历</text>
    <view class="calendar-card">
      <view class="cal-head-row">
        <view wx:for="{{weekHeads}}" wx:key="*this" class="cal-head-cell">
          <text class="cal-head-text">{{item}}</text>
        </view>
      </view>
      <view class="cal-grid">
        <view
          wx:for="{{monthCells}}"
          wx:key="key"
          class="cal-cell"
        >
          <block wx:if="{{!item.blank}}">
            <view class="cal-cell-inner {{item.checked ? 'cal-cell-on' : ''}} {{item.isToday ? 'cal-cell-today' : ''}}">
              <text class="cal-cell-num {{item.checked ? 'cal-num-on' : ''}}">{{item.num}}</text>
            </view>
          </block>
        </view>
      </view>
    </view>
  </view>

  <!-- 最近训练记录 -->
  <view wx:if="{{recent.length}}" class="section">
    <text class="section-title font-headline">最近训练</text>
    <view class="recent-card">
      <view
        wx:for="{{recent}}"
        wx:key="key"
        class="recent-row"
      >
        <view class="recent-icon-wrap">
          <mp-icon name="{{item.icon}}" size="22" color="#c08a7d" />
        </view>
        <view class="recent-info">
          <text class="recent-name">{{item.name}}</text>
          <text wx:if="{{item.scene}}" class="recent-scene">{{item.scene}}</text>
        </view>
        <text class="recent-when">{{item.when}}</text>
      </view>
    </view>
  </view>

  <!-- 空状态引导 -->
  <view wx:if="{{!hasData}}" class="empty-hint">
    <text class="empty-text">还没有训练记录，完成第一次训练即可点亮这里</text>
    <view class="empty-btn" bindtap="goTraining">
      <text class="empty-btn-text">去训练</text>
    </view>
  </view>

  <view style="height: 140rpx"></view>
</view>
