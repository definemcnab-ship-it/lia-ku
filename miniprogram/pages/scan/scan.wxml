<view class="page">

  <!-- Navbar -->
  <view class="navbar">
    <view wx:if="{{step !== 'guide' && step !== 'result'}}" class="back-btn" bindtap="resetAll">
      <text class="back-icon">‹</text>
    </view>
    <view class="navbar-text">
      <text class="page-title font-headline">体态档案</text>
      <text class="page-subtitle">一张照片，看见身体的秩序</text>
    </view>
  </view>

  <scroll-view class="scroll-area" scroll-y>

    <!-- ── 引导页 ── -->
    <block wx:if="{{step === 'guide'}}">
      <view class="section">
        <view class="guide-card">
          <text class="guide-heading font-headline">需要三个角度</text>
          <text class="guide-sub">三面检测才能准确分析你的全身体态</text>
          <view class="angle-list">
            <view wx:for="{{angles}}" wx:key="key" class="angle-preview-row">
              <view class="angle-num">{{index + 1}}</view>
              <view class="angle-preview-info">
                <text class="angle-preview-label">{{item.label}}</text>
                <text class="angle-preview-desc">{{item.desc}}</text>
              </view>
            </view>
          </view>
          <view class="guide-tips">
            <text class="guide-tips-title">拍摄前检查</text>
            <view class="guide-tip-row">
              <text class="guide-tip-dot">·</text>
              <text class="guide-tip-text">穿贴身衣物，避免宽松遮体</text>
            </view>
            <view class="guide-tip-row">
              <text class="guide-tip-dot">·</text>
              <text class="guide-tip-text">选择光线均匀的明亮室内</text>
            </view>
            <view class="guide-tip-row">
              <text class="guide-tip-dot">·</text>
              <text class="guide-tip-text">背景简单，距相机约1.5-2米</text>
            </view>
            <view class="guide-tip-row">
              <text class="guide-tip-dot">·</text>
              <text class="guide-tip-text">建议请他人帮助拍摄</text>
            </view>
          </view>
          <view class="primary-btn" bindtap="startGuide">
            <text class="primary-btn-text">开始检测</text>
          </view>
        </view>
      </view>

      <!-- 历史档案 -->
      <view class="section" wx:if="{{history.length}}">
        <text class="section-title font-headline">历史档案</text>
        <view class="card history-card">
          <view wx:for="{{history}}" wx:key="date" class="history-row">
            <view class="history-dot {{item.score >= 80 ? 'dot-good' : item.score >= 70 ? 'dot-ok' : 'dot-low'}}"></view>
            <view class="history-info">
              <text class="history-date">{{item.date}}</text>
              <text class="history-issues">{{item.issueCount}} 项体态特征</text>
            </view>
            <text class="history-score">{{item.score}}</text>
          </view>
        </view>
      </view>
    </block>

    <!-- ── 前置教学页 ── -->
    <block wx:if="{{step === 'prep'}}">
      <!-- Tab 栏 -->
      <view class="prep-tabs">
        <view class="prep-tab {{prepTab===0?'prep-tab-active':''}}" bindtap="setPrepTab" data-tab="0">着装要求</view>
        <view class="prep-tab {{prepTab===1?'prep-tab-active':''}}" bindtap="setPrepTab" data-tab="1">示范姿势</view>
        <view class="prep-tab {{prepTab===2?'prep-tab-active':''}}" bindtap="setPrepTab" data-tab="2">评估说明</view>
      </view>

      <!-- Tab 0：着装要求 -->
      <view class="section" wx:if="{{prepTab === 0}}">
        <view class="card prep-card">
          <text class="prep-card-title font-headline">着装要求</text>
          <text class="prep-card-sub">以下条件未达到时，请勿开始评估</text>
          <view class="prep-check-row prep-check-pass">
            <text class="prep-check-icon">✓</text>
            <view class="prep-check-info">
              <text class="prep-check-name">上半身</text>
              <text class="prep-check-desc">运动内衣 / 紧身背心 / 贴身上衣，需露出肩颈与腰腹轮廓</text>
            </view>
          </view>
          <view class="prep-check-row prep-check-pass">
            <text class="prep-check-icon">✓</text>
            <view class="prep-check-info">
              <text class="prep-check-name">下半身</text>
              <text class="prep-check-desc">瑜伽裤 / 紧身裤 / 运动短裤，需露出膝关节至踝关节轮廓</text>
            </view>
          </view>
          <view class="prep-check-row prep-check-pass">
            <text class="prep-check-icon">✓</text>
            <view class="prep-check-info">
              <text class="prep-check-name">足部</text>
              <text class="prep-check-desc">光脚，不穿鞋袜，以便观察足弓与踝关节对位</text>
            </view>
          </view>
          <view class="prep-check-row prep-check-fail">
            <text class="prep-check-icon prep-check-icon-x">✗</text>
            <view class="prep-check-info">
              <text class="prep-check-name">不符合条件</text>
              <text class="prep-check-desc">宽松衣物、厚底鞋、穿袜将影响关键点识别，系统将拒绝评估</text>
            </view>
          </view>
        </view>
      </view>

      <!-- Tab 1：三视角示范图 -->
      <view class="section" wx:if="{{prepTab === 1}}">
        <view class="card prep-card">
          <text class="prep-card-title font-headline">三视角示范</text>
          <text class="prep-card-sub">自然站立，双脚与肩同宽，双手自然垂放</text>
          <image class="poster-img" src="/images/poses/pose-front.jpg" mode="widthFix"/>
          <image class="poster-img" src="/images/poses/pose-side.jpg" mode="widthFix"/>
          <image class="poster-img" src="/images/poses/pose-back.jpg" mode="widthFix"/>
        </view>
        <view class="card prep-tip-card">
          <view class="prep-tip-row"><text class="prep-tip-dot">↑</text><text class="prep-tip-text">评估从<text class="prep-tip-em">足底向上</text>逐段分析：足弓→踝→膝→骨盆→腰椎→肩→颈</text></view>
          <view class="prep-tip-row"><text class="prep-tip-dot">▦</text><text class="prep-tip-text">系统同时在<text class="prep-tip-em">三个平面</text>分析：矢状面（前后）、冠状面（左右）、水平面（旋转）</text></view>
          <view class="prep-tip-row"><text class="prep-tip-dot">◎</text><text class="prep-tip-text">建议背景简洁，距相机 <text class="prep-tip-em">1.5–2 米</text>，全身入镜</text></view>
        </view>
      </view>

      <!-- Tab 2：评估说明 -->
      <view class="section" wx:if="{{prepTab === 2}}">
        <view class="card prep-card">
          <text class="prep-card-title font-headline">评估说明</text>
          <view class="explain-row">
            <view class="explain-num">01</view>
            <view class="explain-info">
              <text class="explain-name">AI 辅助筛查，非临床诊断</text>
              <text class="explain-desc">本系统基于 2D/3D 关键点估算体态偏差，结果供参考，不替代专业物理治疗师评估</text>
            </view>
          </view>
          <view class="explain-row">
            <view class="explain-num">02</view>
            <view class="explain-info">
              <text class="explain-name">三视角综合分析</text>
              <text class="explain-desc">正面检测高低肩、溜肩、X/O型腿、骨盆侧倾；侧面检测头前引（CVA）、圆肩、骨盆前倾、膝超伸；背面补充正面分析</text>
            </view>
          </view>
          <view class="explain-row">
            <view class="explain-num">03</view>
            <view class="explain-info">
              <text class="explain-name">挺拔度评分</text>
              <text class="explain-desc">100 分起，每项确认问题按严重程度扣分，部分项目无法精确判定时仅作「建议人工复核」提示</text>
            </view>
          </view>
          <view class="explain-row">
            <view class="explain-num">04</view>
            <view class="explain-info">
              <text class="explain-name">定期复测追踪变化</text>
              <text class="explain-desc">建议每 4 周复测一次，配合针对性课程训练，体态改善通常在 8–12 周内可见</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 底部按钮 -->
      <view class="section">
        <view class="prep-btn-row">
          <view class="secondary-btn" bindtap="resetAll">
            <text class="secondary-btn-text">返回</text>
          </view>
          <view class="primary-btn prep-start-btn" bindtap="startScan">
            <text class="primary-btn-text">我已准备好，开始检测</text>
          </view>
        </view>
      </view>
    </block>

    <!-- ── 拍摄角度页 ── -->
    <block wx:if="{{step === 'angle'}}">
      <!-- 进度条 -->
      <view class="section">
        <view class="progress-row">
          <view wx:for="{{angles}}" wx:key="key" class="progress-step">
            <view class="progress-circle {{index < angleIdx ? 'circle-done' : index === angleIdx ? 'circle-active' : 'circle-idle'}}">
              <text wx:if="{{index < angleIdx}}" class="progress-check">✓</text>
              <text wx:else class="progress-num">{{index + 1}}</text>
            </view>
            <text class="progress-label {{index === angleIdx ? 'label-active' : ''}}">{{item.label}}</text>
            <view wx:if="{{index < angles.length - 1}}" class="progress-line {{index < angleIdx ? 'line-done' : ''}}"></view>
          </view>
        </view>
      </view>


      <!-- 拍摄要求 -->
      <view class="section">
        <view class="angle-card">
          <text class="angle-label font-headline">{{angles[angleIdx].label}}拍摄要求</text>
          <text class="angle-tip">{{angles[angleIdx].tip}}</text>
          <image wx:if="{{angleIdx === 0}}" class="poster-img" src="/images/poses/pose-front.jpg" mode="widthFix"/>
          <image wx:elif="{{angleIdx === 1}}" class="poster-img" src="/images/poses/pose-side.jpg" mode="widthFix"/>
          <image wx:else class="poster-img" src="/images/poses/pose-back.jpg" mode="widthFix"/>
        </view>
      </view>

      <!-- 上传按钮 -->
      <view class="section">
        <view class="upload-btn" bindtap="uploadAngle">
          <view class="upload-icon-wrap">
            <mp-icon name="photo_camera" size="36" color="#ffffff" />
          </view>
          <text class="upload-btn-text">拍摄 / 从相册选择{{angles[angleIdx].label}}照片</text>
        </view>
      </view>
    </block>

    <!-- ── 校验中 ── -->
    <block wx:if="{{step === 'checking'}}">
      <view class="section">
        <view class="card loading-card">
          <view class="spinner"></view>
          <text class="loading-text">照片校验中…</text>
          <text class="loading-sub">检查角度与拍摄质量</text>
        </view>
      </view>
    </block>

    <!-- ── 校验不通过 ── -->
    <block wx:if="{{step === 'fail'}}">
      <view class="section">
        <view class="card fail-card">
          <view class="fail-icon">✗</view>
          <text class="fail-title">照片不符合要求</text>
          <text class="fail-reason">{{failReason}}</text>
          <view class="req-list" style="margin-top:32rpx;">
            <view wx:for="{{angles[angleIdx].reqs}}" wx:key="index" class="req-row">
              <view class="req-check-wrap">
                <text class="req-check">✓</text>
              </view>
              <text class="req-text">{{item}}</text>
            </view>
          </view>
          <view class="primary-btn" bindtap="retry" style="margin-top:40rpx;">
            <text class="primary-btn-text">重新拍摄</text>
          </view>
        </view>
      </view>
    </block>

    <!-- ── 综合分析中 ── -->
    <block wx:if="{{step === 'analyzing'}}">
      <view class="section">
        <view class="card loading-card">
          <view class="spinner"></view>
          <text class="loading-text">AI 综合分析中…</text>
          <text class="loading-sub">正面 · 侧面 · 背面三维建模</text>
          <text class="loading-sub" style="margin-top:8rpx;">识别体态模式与肌肉失衡</text>
        </view>
      </view>
    </block>

    <!-- ── 结果 ── -->
    <block wx:if="{{step === 'result'}}">

      <!-- 评分卡 -->
      <view class="section">
        <view class="card score-card">
          <view class="score-row">
            <view class="score-circle-outer">
              <view class="score-circle">
                <text class="score-number">{{result.score}}</text>
                <text class="score-unit">分</text>
              </view>
            </view>
            <view class="score-label-wrap">
              <text class="score-title font-headline">挺拔度参考</text>
              <text class="score-desc">{{result.score >= 80 ? '整体体态良好，继续保持' : result.score >= 70 ? '整体良好，有提升空间' : '建议系统训练改善'}}</text>
              <view class="score-badge">
                <mp-icon name="trending_up" size="18" color="#c08a7d" />
                <text class="score-badge-text">三维综合评分</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 与上次对比 -->
      <view class="section" wx:if="{{compare}}">
        <text class="section-title font-headline">与上次对比</text>
        <view class="card compare-card">
          <view class="compare-head">
            <text class="compare-prev-date">上次检测 {{compare.prevDate}}</text>
            <text class="compare-score {{compare.scoreDiff > 0 ? 'compare-up' : compare.scoreDiff < 0 ? 'compare-down' : ''}}">
              {{compare.scoreDiff > 0 ? '+' : ''}}{{compare.scoreDiff}} 分
            </text>
          </view>
          <block wx:if="{{compare.items.length}}">
            <view wx:for="{{compare.items}}" wx:key="label" class="compare-row">
              <view class="compare-dot {{item.resolved ? 'cdot-good' : item.isNew ? 'cdot-new' : item.better ? 'cdot-good' : 'cdot-warn'}}"></view>
              <view class="compare-info">
                <text class="compare-label">{{item.label}}</text>
                <text wx:if="{{item.resolved}}" class="compare-change compare-up">本次未再检出</text>
                <text wx:elif="{{item.isNew}}" class="compare-change compare-down">本次新检出</text>
                <text wx:else class="compare-change {{item.better ? 'compare-up' : 'compare-down'}}">{{item.from}} → {{item.to}}</text>
              </view>
            </view>
          </block>
          <text wx:else class="compare-empty">各项测量与上次基本持平，坚持训练，变化在路上</text>
        </view>
      </view>

      <!-- 发现问题 -->
      <view class="section">
        <text class="section-title font-headline">发现的体态特征</text>
        <view class="card issues-card">
          <view wx:for="{{result.issues}}" wx:key="key" class="issue-item">
            <view class="issue-icon-wrap">
              <mp-icon name="{{item.icon}}" size="22" color="#c08a7d" />
            </view>
            <view class="issue-info">
              <view class="issue-name-row">
                <text class="issue-name">{{item.issue}}</text>
                <text wx:if="{{item.measure}}" class="issue-measure-badge">{{item.measure}}</text>
              </view>
              <text class="issue-detail">{{item.detail}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 建议人工复核（低置信提示，不计入评分） -->
      <view class="section" wx:if="{{result.reviews.length > 0}}">
        <text class="section-title font-headline">建议人工复核</text>
        <view class="card reviews-card">
          <view wx:for="{{result.reviews}}" wx:key="issue" class="review-item">
            <view class="review-icon-wrap">
              <mp-icon name="{{item.icon}}" size="20" color="#a99f93" />
            </view>
            <view class="issue-info">
              <text class="review-name">{{item.issue}}</text>
              <text class="issue-detail">{{item.detail}}</text>
            </view>
          </view>
          <text class="review-foot">以上项目受 2D 照片限制无法精确判定，仅作提示，建议线下专业评估</text>
        </view>
      </view>

      <!-- 专属康复计划入口 -->
      <view class="section">
        <view class="rehab-plan-card" bindtap="goRehabPlan">
          <view class="rehab-plan-icon">
            <mp-icon name="auto_awesome" size="28" color="#c08a7d" />
          </view>
          <view class="rehab-plan-info">
            <text class="rehab-plan-title font-headline">生成专属康复计划</text>
            <text class="rehab-plan-sub">基于检测结果 · 12周三阶段 · 居家/办公/健身房</text>
          </view>
          <mp-icon name="arrow_forward" size="20" color="#c08a7d" />
        </view>
      </view>

      <!-- 课程建议 -->
      <view class="section">
        <text class="section-title font-headline">针对性改善课程</text>
        <view class="suggestions-wrap">
          <view
            wx:for="{{result.issues}}"
            wx:key="key"
            class="suggestion-card"
            bindtap="goToCourse"
            data-course-id="{{item.courseId}}"
          >
            <view class="suggestion-icon-wrap">
              <mp-icon name="{{item.icon}}" size="24" color="#8f8779" />
            </view>
            <view class="suggestion-info">
              <text class="suggestion-name">{{item.courseName}}</text>
              <text class="suggestion-sub">针对 · {{item.issue}}</text>
            </view>
            <mp-icon name="arrow_forward" size="20" color="#b8b0a4" />
          </view>
        </view>
      </view>

      <!-- 重新检测 -->
      <view class="section">
        <view class="rescan-btn" bindtap="resetAll">
          <text class="rescan-text">重新检测</text>
        </view>
      </view>

    </block>

    <view style="height: 140rpx"></view>
  </scroll-view>
</view>
