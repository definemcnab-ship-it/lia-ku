page { background: #f7f5f0; }
.page { min-height: 100vh; background: #f7f5f0; }

/* ── Navbar ── */
.navbar {
  padding: 100rpx 48rpx 32rpx;
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}
.back-btn {
  padding-top: 8rpx;
  flex-shrink: 0;
}
.back-icon {
  font-size: 52rpx;
  color: #2b2720;
  line-height: 1;
}
.navbar-text { flex: 1; }
.page-title {
  display: block;
  font-size: 52rpx;
  color: #2b2720;
  font-weight: 300;
}
.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: #8f8779;
  margin-top: 6rpx;
}

.scroll-area { height: calc(100vh - 230rpx); }
.section { padding: 0 40rpx 28rpx; }
.section-title {
  display: block;
  font-size: 40rpx;
  color: #2b2720;
  font-weight: 300;
  margin-bottom: 20rpx;
}
.card {
  background: #ffffff;
  border-radius: 40rpx;
  padding: 44rpx;
  box-shadow: 0 4rpx 24rpx rgba(43,39,32,0.05);
}

/* ── 引导页 ── */
.guide-card {
  background: #ffffff;
  border-radius: 40rpx;
  padding: 48rpx 44rpx;
}
.guide-heading {
  display: block;
  font-size: 48rpx;
  color: #2b2720;
  font-weight: 300;
  margin-bottom: 10rpx;
}
.guide-sub {
  display: block;
  font-size: 26rpx;
  color: #8f8779;
  margin-bottom: 40rpx;
}
.angle-list { margin-bottom: 40rpx; }
.angle-preview-row {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f4f1ec;
}
.angle-preview-row:last-child { border-bottom: none; }
.angle-num {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #fdf0ed;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #c08a7d;
  flex-shrink: 0;
}
.angle-preview-label {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #2b2720;
  margin-bottom: 6rpx;
}
.angle-preview-desc {
  display: block;
  font-size: 24rpx;
  color: #8f8779;
  line-height: 1.5;
}
.guide-tips {
  background: #f7f5f0;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 40rpx;
}
.guide-tips-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #3f3a32;
  margin-bottom: 16rpx;
}
.guide-tip-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.guide-tip-dot { font-size: 28rpx; color: #c08a7d; flex-shrink: 0; }
.guide-tip-text { font-size: 26rpx; color: #6e675b; line-height: 1.6; }

/* ── 进度条 ── */
.progress-row {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: 0;
  padding: 8rpx 0;
}
/* ═══════════════════════════════════
   前置教学页 (prep)
═══════════════════════════════════ */
.prep-tabs {
  display: flex; flex-direction: row;
  background: #f7f5f0; border-bottom: 1rpx solid #e8e2d8;
  padding: 0 32rpx;
}
.prep-tab {
  flex: 1; text-align: center;
  font-size: 26rpx; color: #8f8779;
  padding: 24rpx 0 20rpx;
  border-bottom: 4rpx solid transparent;
}
.prep-tab-active { color: #c08a7d; border-bottom-color: #c08a7d; font-weight: 600; }

.prep-card { padding: 40rpx; }
.prep-card-title { display: block; font-size: 32rpx; font-weight: 700; color: #2b2720; margin-bottom: 8rpx; }
.prep-card-sub { display: block; font-size: 24rpx; color: #8f8779; margin-bottom: 36rpx; }

.prep-check-row {
  display: flex; align-items: flex-start; gap: 24rpx;
  padding: 24rpx 0; border-bottom: 1rpx solid #f4f1ec;
}
.prep-check-row:last-child { border-bottom: none; }
.prep-check-pass { opacity: 1; }
.prep-check-fail { opacity: 0.85; }
.prep-check-icon {
  width: 52rpx; height: 52rpx; border-radius: 50%;
  background: #e8f5e9; color: #5b9e6a;
  font-size: 28rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.prep-check-icon-x { background: #fdecea; color: #c0504d; }
.prep-check-info { flex: 1; }
.prep-check-name { display: block; font-size: 28rpx; font-weight: 600; color: #2b2720; margin-bottom: 6rpx; }
.prep-check-desc { display: block; font-size: 24rpx; color: #8f8779; line-height: 1.6; }

/* 示范图 */
.pose-demo-row { display: flex; flex-direction: row; gap: 16rpx; margin-bottom: 32rpx; }
.pose-demo-col { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.pose-demo-img { width: 100%; height: 320rpx; border-radius: 12rpx; }
.poster-img { width: 100%; border-radius: 16rpx; margin-bottom: 20rpx; display: block; }
.pose-grid-wrap {
  position: relative; width: 100%; padding-bottom: 160%;
  background: #f0ece4; border-radius: 12rpx; overflow: hidden;
}
.pose-grid { position: absolute; inset: 0; }
.grid-line { position: absolute; background: rgba(192,138,125,0.18); }
.grid-v1 { left: 33%; top: 0; bottom: 0; width: 1rpx; }
.grid-v2 { left: 67%; top: 0; bottom: 0; width: 1rpx; }
.grid-h1 { top: 12%; left: 0; right: 0; height: 1rpx; }
.grid-h2 { top: 30%; left: 0; right: 0; height: 1rpx; }
.grid-h3 { top: 56%; left: 0; right: 0; height: 1rpx; }
.grid-h4 { top: 78%; left: 0; right: 0; height: 1rpx; }
.pose-center-line {
  position: absolute; left: 50%; top: 0; bottom: 0;
  width: 2rpx; background: rgba(192,138,125,0.5);
  transform: translateX(-50%);
}
.pose-silhouette { position: absolute; inset: 0; width: 100%; height: 100%; }

/* 关键点圆点 */
.pose-dot {
  position: absolute; width: 14rpx; height: 14rpx; border-radius: 50%;
  background: #c08a7d; border: 2rpx solid #fff;
}
.pose-dot-shoulder-l { top: 22%; left: 22%; }
.pose-dot-shoulder-r { top: 22%; right: 22%; }
.pose-dot-hip-l { top: 52%; left: 26%; }
.pose-dot-hip-r { top: 52%; right: 26%; }
.pose-dot-knee-l { top: 68%; left: 28%; }
.pose-dot-knee-r { top: 68%; right: 28%; }
.pose-dot-ankle-l { top: 86%; left: 30%; }
.pose-dot-ankle-r { top: 86%; right: 30%; }
.pose-dot-ear { top: 10%; left: 55%; }
.pose-dot-shoulder-s { top: 22%; left: 42%; }
.pose-dot-hip-s { top: 52%; left: 52%; }
.pose-dot-knee-s { top: 68%; left: 48%; }
.pose-dot-ankle-s { top: 86%; left: 46%; }

/* CSS 人形轮廓 */
.fig { position: absolute; inset: 0; }
.fig-head {
  position: absolute; left: 50%; top: 6%;
  width: 36rpx; height: 36rpx; border-radius: 50%;
  background: #c9b8ae; transform: translateX(-50%);
}
.fig-neck {
  position: absolute; left: 50%; top: 17%;
  width: 12rpx; height: 10%;
  background: #c9b8ae; transform: translateX(-50%);
}
.fig-torso {
  position: absolute; left: 50%; top: 26%;
  width: 48rpx; height: 28%;
  background: #c9b8ae; border-radius: 8rpx; transform: translateX(-50%);
}
.fig-arm-l {
  position: absolute; left: 28%; top: 27%;
  width: 10rpx; height: 26%;
  background: #c9b8ae; border-radius: 5rpx;
  transform: rotate(8deg);
}
.fig-arm-r {
  position: absolute; right: 28%; top: 27%;
  width: 10rpx; height: 26%;
  background: #c9b8ae; border-radius: 5rpx;
  transform: rotate(-8deg);
}
.fig-leg-l {
  position: absolute; left: 40%; top: 54%;
  width: 18rpx; height: 40%;
  background: #c9b8ae; border-radius: 6rpx;
}
.fig-leg-r {
  position: absolute; right: 40%; top: 54%;
  width: 18rpx; height: 40%;
  background: #c9b8ae; border-radius: 6rpx;
}
/* 侧面 */
.fig-torso-s {
  position: absolute; left: 42%; top: 26%;
  width: 28rpx; height: 28%;
  background: #c9b8ae; border-radius: 8rpx;
}
.fig-arm-s {
  position: absolute; left: 62%; top: 27%;
  width: 10rpx; height: 26%;
  background: #c9b8ae; border-radius: 5rpx;
  transform: rotate(6deg);
}
.fig-leg-s {
  position: absolute; left: 46%; top: 54%;
  width: 18rpx; height: 40%;
  background: #c9b8ae; border-radius: 6rpx;
}

.pose-label { font-size: 26rpx; font-weight: 600; color: #2b2720; }
.pose-plane { font-size: 22rpx; color: #a09890; }

/* 拍摄页内的单张大示范图 */
.demo-card { padding: 32rpx 40rpx 28rpx; }
.demo-title { display: block; font-size: 26rpx; font-weight: 600; color: #6e675b; margin-bottom: 24rpx; text-align: center; }
.demo-pose-img {
  width: 320rpx; height: 480rpx; display: block; margin: 0 auto;
  border-radius: 16rpx; overflow: hidden;
}
.demo-plane { display: block; text-align: center; font-size: 23rpx; color: #a09890; margin-top: 20rpx; }

.pose-legend { display: flex; flex-direction: column; gap: 12rpx; margin-top: 8rpx; }
.pose-legend-row { display: flex; align-items: center; gap: 12rpx; }
.pose-dot-mini { width: 14rpx; height: 14rpx; border-radius: 50%; background: #c08a7d; flex-shrink: 0; }
.pose-center-mini { width: 22rpx; height: 2rpx; background: rgba(192,138,125,0.5); flex-shrink: 0; }
.pose-legend-text { font-size: 22rpx; color: #8f8779; }

.prep-tip-card { padding: 32rpx 40rpx; }
.prep-tip-row { display: flex; align-items: flex-start; gap: 20rpx; margin-bottom: 22rpx; }
.prep-tip-row:last-child { margin-bottom: 0; }
.prep-tip-dot { font-size: 28rpx; color: #c08a7d; flex-shrink: 0; margin-top: 2rpx; }
.prep-tip-text { font-size: 26rpx; color: #6e675b; line-height: 1.7; }
.prep-tip-em { color: #c08a7d; font-weight: 600; }

/* 评估说明 */
.explain-row { display: flex; align-items: flex-start; gap: 28rpx; padding: 28rpx 0; border-bottom: 1rpx solid #f4f1ec; }
.explain-row:last-child { border-bottom: none; }
.explain-num {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: #fdf0ed; color: #c08a7d;
  font-size: 22rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.explain-info { flex: 1; }
.explain-name { display: block; font-size: 28rpx; font-weight: 600; color: #2b2720; margin-bottom: 8rpx; }
.explain-desc { display: block; font-size: 24rpx; color: #8f8779; line-height: 1.6; }

/* 底部按钮组 */
.prep-btn-row { display: flex; flex-direction: row; gap: 24rpx; }
.secondary-btn {
  flex: 0 0 160rpx; height: 88rpx; border-radius: 44rpx;
  background: #f0ece4; display: flex; align-items: center; justify-content: center;
}
.secondary-btn-text { font-size: 28rpx; color: #6e675b; }
.prep-start-btn { flex: 1; }

.progress-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  position: relative;
  flex: 1;
}
.progress-circle {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  z-index: 1;
}
.circle-done { background: #c08a7d; }
.circle-active { background: #2b2720; }
.circle-idle { background: #ece8e0; }
.progress-check { color: #ffffff; font-size: 28rpx; }
.progress-num { color: #ffffff; }
.circle-idle .progress-num { color: #9e9688; }
.progress-label {
  font-size: 22rpx;
  color: #8f8779;
  text-align: center;
}
.label-active { color: #2b2720; font-weight: 600; }
.progress-line {
  position: absolute;
  top: 30rpx;
  left: calc(50% + 32rpx);
  width: calc(100% - 64rpx);
  height: 3rpx;
  background: #ece8e0;
}
.line-done { background: #c08a7d; }

/* ── 拍摄要求卡 ── */
.angle-card {
  background: #ffffff;
  border-radius: 40rpx;
  padding: 44rpx;
}
.angle-label {
  display: block;
  font-size: 44rpx;
  color: #2b2720;
  font-weight: 300;
  margin-bottom: 8rpx;
}
.angle-tip {
  display: block;
  font-size: 24rpx;
  color: #8f8779;
  margin-bottom: 36rpx;
  line-height: 1.5;
}
.req-list { display: flex; flex-direction: column; gap: 16rpx; }
.req-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  background: #f7f5f0;
  border-radius: 20rpx;
}
.req-check-wrap {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #c08a7d;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2rpx;
}
.req-check { font-size: 20rpx; color: #ffffff; font-weight: 700; }
.req-text { font-size: 27rpx; color: #3f3a32; line-height: 1.6; flex: 1; }
.angle-desc-badge {
  display: block;
  font-size: 22rpx;
  color: #8f8779;
  margin-top: 28rpx;
  background: #f4f1ec;
  border-radius: 16rpx;
  padding: 10rpx 20rpx;
  align-self: flex-start;
}

/* ── 上传按钮 ── */
.upload-btn {
  background: #2b2720;
  border-radius: 24rpx;
  padding: 36rpx 40rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  justify-content: center;
}
.upload-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}
.upload-btn-text { font-size: 30rpx; color: #f7f5f0; font-weight: 500; }

/* ── 加载/校验 ── */
.loading-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx;
  gap: 20rpx;
}
.spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #f4f1ec;
  border-top-color: #c08a7d;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 34rpx; font-weight: 600; color: #2b2720; }
.loading-sub { font-size: 26rpx; color: #8f8779; text-align: center; }

/* ── 不通过 ── */
.fail-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 44rpx 44rpx;
}
.fail-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #fdf0ed;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  color: #c08a7d;
  margin-bottom: 24rpx;
}
.fail-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #2b2720;
  margin-bottom: 12rpx;
}
.fail-reason {
  font-size: 26rpx;
  color: #8f8779;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

/* ── 主按钮 ── */
.primary-btn {
  width: 100%;
  background: #2b2720;
  border-radius: 24rpx;
  padding: 32rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.primary-btn-text { font-size: 32rpx; color: #f7f5f0; }

/* ── 结果页 ── */
.score-card { padding: 44rpx; }
.score-row { display: flex; align-items: center; gap: 40rpx; }
.score-circle-outer {
  width: 156rpx; height: 156rpx; border-radius: 50%;
  background: linear-gradient(135deg, #c08a7d, #d4a090);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 8rpx 32rpx rgba(192,138,125,0.3);
}
.score-circle {
  width: 128rpx; height: 128rpx; background: #fff7f5;
  border-radius: 50%; display: flex; flex-direction: column;
  align-items: center; justify-content: center;
}
.score-number { font-size: 52rpx; font-weight: 800; color: #c08a7d; line-height: 1; }
.score-unit { font-size: 20rpx; color: #8f8779; }
.score-label-wrap { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.score-title { display: block; font-size: 34rpx; color: #2b2720; }
.score-desc { display: block; font-size: 24rpx; color: #8f8779; line-height: 1.5; }
.score-badge {
  display: flex; align-items: center; gap: 8rpx;
  background: #fdf0ed; border-radius: 20rpx; padding: 8rpx 20rpx;
  align-self: flex-start; margin-top: 8rpx;
}
.score-badge-text { font-size: 22rpx; color: #c08a7d; }

.issues-card { padding: 12rpx 40rpx; }
.issue-item {
  display: flex; align-items: flex-start; gap: 24rpx;
  padding: 28rpx 0; border-bottom: 1rpx solid #f4f1ec;
}
.issue-item:last-child { border-bottom: none; }
.issue-icon-wrap {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: #fdf0ed; display: flex; align-items: center;
  justify-content: center; flex-shrink: 0;
}
.issue-info { flex: 1; }
.issue-name-row { display: flex; flex-direction: row; align-items: center; flex-wrap: wrap; gap: 8rpx; margin-bottom: 6rpx; }
.issue-name { font-size: 28rpx; font-weight: 600; color: #2b2720; }
.issue-measure-badge { font-size: 20rpx; color: #c08a7d; background: #f9ece8; border-radius: 8rpx; padding: 2rpx 10rpx; font-weight: 600; }
.issue-detail { display: block; font-size: 24rpx; color: #8f8779; line-height: 1.6; }

/* 建议人工复核（低置信，弱化呈现） */
.reviews-card { padding: 12rpx 40rpx 28rpx; background: #faf8f4; }
.review-item {
  display: flex; align-items: flex-start; gap: 24rpx;
  padding: 28rpx 0; border-bottom: 1rpx solid #f0ece5;
}
.review-icon-wrap {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: #f0ece4; display: flex; align-items: center;
  justify-content: center; flex-shrink: 0;
}
.review-name { display: block; font-size: 28rpx; font-weight: 600; color: #6f685c; margin-bottom: 6rpx; }
.review-foot { display: block; font-size: 22rpx; color: #b0a899; line-height: 1.6; margin-top: 20rpx; }

.suggestions-wrap { display: flex; flex-direction: column; gap: 16rpx; }
.suggestion-card {
  background: #ffffff; border-radius: 28rpx; padding: 32rpx 36rpx;
  display: flex; align-items: center; gap: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(43,39,32,0.05);
}
.suggestion-icon-wrap {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: #f7f5f0; display: flex; align-items: center;
  justify-content: center; flex-shrink: 0;
}
.suggestion-info { flex: 1; min-width: 0; }
.suggestion-name { display: block; font-size: 28rpx; font-weight: 600; color: #2b2720; margin-bottom: 6rpx; }
.suggestion-sub { display: block; font-size: 22rpx; color: #8f8779; }

.rescan-btn { background: #f4f1ec; border-radius: 24rpx; padding: 28rpx 0; text-align: center; }
.rescan-text { font-size: 30rpx; color: #6e675b; }

/* ── 历史档案 ── */
.history-card { padding: 12rpx 40rpx; }
.history-row {
  display: flex; align-items: center; gap: 24rpx;
  padding: 28rpx 0; border-bottom: 1rpx solid #f4f1ec;
}
.history-row:last-child { border-bottom: none; }
.history-dot { width: 20rpx; height: 20rpx; border-radius: 50%; flex-shrink: 0; }
.dot-good { background: #7db87d; }
.dot-ok   { background: #c08a7d; }
.dot-low  { background: #c4955a; }
.history-info { flex: 1; }
.history-date { display: block; font-size: 28rpx; color: #2b2720; }
.history-issues { display: block; font-size: 24rpx; color: #8f8779; margin-top: 4rpx; }
.history-score { font-size: 40rpx; color: #c08a7d; font-weight: 200; }

/* ── 专属康复计划入口卡 ── */
.rehab-plan-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #fbf3ef 0%, #f6ece6 100%);
  border: 2rpx solid #ecdcd5;
  box-shadow: 0 4rpx 20rpx rgba(192, 138, 125, 0.1);
}
.rehab-plan-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 2rpx 12rpx rgba(192, 138, 125, 0.15);
}
.rehab-plan-info { flex: 1; }
