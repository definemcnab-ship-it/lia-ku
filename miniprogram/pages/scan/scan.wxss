page { background: #f7f5f0; }

.page {
  min-height: 100vh;
  background: #f7f5f0;
}

/* ── Navbar ── */
.navbar {
  padding: 100rpx 48rpx 32rpx;
}
.page-title {
  display: block;
  font-size: 56rpx;
  color: #2b2720;
  font-weight: 300;
}
.page-subtitle {
  display: block;
  font-size: 28rpx;
  color: #8f8779;
  margin-top: 8rpx;
}

.scroll-area {
  height: calc(100vh - 220rpx);
}

.section {
  padding: 0 40rpx 28rpx;
}

.section-title {
  display: block;
  font-size: 40rpx;
  color: #2b2720;
  font-weight: 300;
  margin-bottom: 20rpx;
}

/* ── Card base ── */
.card {
  background: #ffffff;
  border-radius: 40rpx;
  padding: 44rpx;
  box-shadow: 0 4rpx 24rpx rgba(43,39,32,0.05);
}

/* ── 上传区 ── */
.upload-card {
  background: #ffffff;
  border-radius: 40rpx;
  border: 3rpx dashed #d4b8b2;
  padding: 80rpx 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 24rpx rgba(43,39,32,0.05);
}
.upload-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.camera-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  background: #fdf0ed;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}
.upload-label {
  font-size: 34rpx;
  font-weight: 600;
  color: #2b2720;
}
.upload-hint {
  font-size: 26rpx;
  color: #8f8779;
}

/* ── 加载 ── */
.loading-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx;
  gap: 24rpx;
}
.spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #f4f1ec;
  border-top-color: #c08a7d;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 34rpx; font-weight: 600; color: #2b2720; }
.loading-sub { font-size: 26rpx; color: #8f8779; }

/* ── 评分卡 ── */
.score-card { padding: 44rpx; }
.score-row {
  display: flex;
  align-items: center;
  gap: 40rpx;
}
.score-circle-outer {
  width: 156rpx;
  height: 156rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #c08a7d, #d4a090);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 8rpx 32rpx rgba(192,138,125,0.3);
}
.score-circle {
  width: 128rpx;
  height: 128rpx;
  background: #fff7f5;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.score-number {
  font-size: 52rpx;
  font-weight: 800;
  color: #c08a7d;
  line-height: 1;
}
.score-unit { font-size: 20rpx; color: #8f8779; }
.score-label-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.score-title { display: block; font-size: 34rpx; color: #2b2720; }
.score-desc { display: block; font-size: 24rpx; color: #8f8779; line-height: 1.5; }
.score-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #fdf0ed;
  border-radius: 20rpx;
  padding: 8rpx 20rpx;
  align-self: flex-start;
  margin-top: 8rpx;
}
.score-badge-text { font-size: 22rpx; color: #c08a7d; }

/* ── 问题卡 ── */
.issues-card { padding: 12rpx 40rpx; }
.issue-item {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f4f1ec;
}
.issue-item:last-child { border-bottom: none; }
.issue-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #fdf0ed;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.issue-info { flex: 1; }
.issue-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2b2720;
  margin-bottom: 6rpx;
}
.issue-detail {
  display: block;
  font-size: 24rpx;
  color: #8f8779;
  line-height: 1.6;
}

/* ── 课程建议 ── */
.suggestions-wrap {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.suggestion-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx 36rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(43,39,32,0.05);
}
.suggestion-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f7f5f0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.suggestion-info { flex: 1; min-width: 0; }
.suggestion-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2b2720;
  margin-bottom: 6rpx;
}
.suggestion-sub {
  display: block;
  font-size: 22rpx;
  color: #8f8779;
}

/* ── 重新检测 ── */
.rescan-btn {
  background: #f4f1ec;
  border-radius: 24rpx;
  padding: 28rpx 0;
  text-align: center;
}
.rescan-text {
  font-size: 30rpx;
  color: #6e675b;
}

/* ── Tips ── */
.tips-card { padding: 40rpx 44rpx; }
.tip-item {
  display: flex;
  align-items: flex-start;
  gap: 28rpx;
  margin-bottom: 36rpx;
}
.tip-item:last-child { margin-bottom: 0; }
.tip-index {
  width: 52rpx;
  height: 52rpx;
  background: #fdf0ed;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #c08a7d;
  flex-shrink: 0;
}
.tip-content { flex: 1; padding-top: 4rpx; }
.tip-text { display: block; font-size: 30rpx; font-weight: 600; color: #2b2720; }
.tip-desc { display: block; font-size: 26rpx; color: #8f8779; margin-top: 6rpx; line-height: 1.6; }

/* ── 历史档案 ── */
.history-card { padding: 12rpx 40rpx; }
.history-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f4f1ec;
}
.history-row:last-child { border-bottom: none; }
.history-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.dot-good { background: #7db87d; }
.dot-ok   { background: #c08a7d; }
.dot-low  { background: #c4955a; }
.history-info { flex: 1; }
.history-date { display: block; font-size: 28rpx; color: #2b2720; }
.history-issues { display: block; font-size: 24rpx; color: #8f8779; margin-top: 4rpx; }
.history-score {
  font-size: 40rpx;
  color: #c08a7d;
  font-weight: 200;
}
