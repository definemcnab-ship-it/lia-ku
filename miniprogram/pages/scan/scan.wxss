/* scan.wxss */
page { background: #f7f5f0; }

.page {
  min-height: 100vh;
  background: #f7f5f0;
}

/* Navbar */
.navbar {
  padding: 100rpx 48rpx 40rpx;
  background: #f7f5f0;
}
.page-title {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: #2b2720;
  letter-spacing: 2rpx;
}
.page-subtitle {
  display: block;
  font-size: 28rpx;
  color: #8f8779;
  margin-top: 8rpx;
}

/* Scroll area */
.scroll-area {
  height: calc(100vh - 220rpx);
}

/* Section spacing */
.section {
  padding: 0 40rpx 32rpx;
}

/* Card base */
.card {
  background: #ffffff;
  border-radius: 40rpx;
  padding: 48rpx;
  box-shadow: 0 4rpx 24rpx rgba(43,39,32,0.06);
}

/* Upload card */
.upload-card {
  background: #ffffff;
  border-radius: 40rpx;
  border: 3rpx dashed #c08a7d;
  padding: 80rpx 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 24rpx rgba(43,39,32,0.06);
}
.upload-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.camera-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  background: #f4f1ec;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}
.upload-label {
  font-size: 34rpx;
  font-weight: 600;
  color: #2b2720;
}
.upload-hint {
  font-size: 26rpx;
  color: #8f8779;
}

/* Loading card */
.loading-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx;
  gap: 24rpx;
}
.spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #f4f1ec;
  border-top-color: #c08a7d;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #2b2720;
}
.loading-sub {
  font-size: 26rpx;
  color: #8f8779;
}

/* Result card */
.result-card {
  padding: 48rpx;
}
.score-row {
  display: flex;
  align-items: center;
  gap: 40rpx;
  margin-bottom: 40rpx;
}
.score-circle {
  width: 140rpx;
  height: 140rpx;
  background: linear-gradient(135deg, #c08a7d, #d4a090);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.score-number {
  font-size: 56rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1;
}
.score-unit {
  font-size: 22rpx;
  color: rgba(255,255,255,0.85);
}
.score-label-wrap {
  flex: 1;
}
.score-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #2b2720;
}
.score-desc {
  display: block;
  font-size: 26rpx;
  color: #8f8779;
  margin-top: 8rpx;
}

.divider {
  height: 1rpx;
  background: #f4f1ec;
  margin: 32rpx 0;
}

.section-label {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #2b2720;
  margin-bottom: 24rpx;
}

.issues-section, .suggestions-section {
  margin-bottom: 8rpx;
}

.issue-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
}
.issue-text {
  font-size: 30rpx;
  color: #2b2720;
}

.suggestion-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
}
.suggestion-text {
  font-size: 30rpx;
  color: #2b2720;
}

.reset-btn-wrap {
  margin-top: 40rpx;
}
.reset-btn {
  background: #2b2720;
  border-radius: 999rpx;
  padding: 28rpx 0;
  text-align: center;
}
.reset-btn-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 2rpx;
}

/* Tips card */
.tips-card {
  padding: 48rpx;
}
.tips-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #2b2720;
  margin-bottom: 40rpx;
}
.tip-item {
  display: flex;
  align-items: flex-start;
  gap: 28rpx;
  margin-bottom: 36rpx;
}
.tip-item:last-child { margin-bottom: 0; }
.tip-index {
  width: 52rpx;
  height: 52rpx;
  background: #f4f1ec;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #c08a7d;
  flex-shrink: 0;
}
.tip-content {
  flex: 1;
  padding-top: 4rpx;
}
.tip-text {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #2b2720;
}
.tip-desc {
  display: block;
  font-size: 26rpx;
  color: #8f8779;
  margin-top: 6rpx;
}

.bottom-spacer { height: 60rpx; }
