<view class="page">

  <!-- 页面 Header -->
  <view class="page-header">
    <view class="header-text">
      <text class="header-title font-headline">训练课程</text>
      <text class="header-subtitle">舒展 · 唤醒 · 归位</text>
    </view>
    <view class="header-icon-wrap">
      <mp-icon name="fitness_center" size="24" color="#8f8779" />
    </view>
  </view>

  <!-- 筛选 Tabs -->
  <scroll-view class="filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="filter-row">
      <view
        wx:for="{{filters}}"
        wx:key="index"
        class="filter-tab {{activeFilter === index ? 'filter-tab-active' : ''}}"
        bindtap="switchFilter"
        data-idx="{{index}}"
      >
        <text class="filter-tab-text {{activeFilter === index ? 'filter-tab-text-active' : ''}}">{{item}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 今日推荐 -->
  <text class="section-label">今日推荐</text>
  <view class="recommend-card">
    <view class="recommend-banner">
      <view class="recommend-banner-deco"></view>
      <view class="recommend-tag">
        <text class="recommend-tag-text">TODAY</text>
      </view>
      <view class="recommend-icon-wrap">
        <mp-icon name="self_improvement" size="48" color="rgba(255,255,255,0.9)" />
      </view>
    </view>
    <view class="recommend-body">
      <text class="recommend-name">颈线 · 养成</text>
      <text class="recommend-desc">颈线向上 · 轻盈生长</text>
      <view class="recommend-meta">
        <view class="recommend-meta-tag">
          <mp-icon name="calendar_month" size="14" color="#8f8779" />
          <text class="recommend-meta-text">15分钟</text>
        </view>
        <view class="recommend-meta-tag">
          <mp-icon name="analytics" size="14" color="#8f8779" />
          <text class="recommend-meta-text">4个动作</text>
        </view>
        <view class="recommend-meta-tag">
          <mp-icon name="trending_up" size="14" color="#8f8779" />
          <text class="recommend-meta-text">初级</text>
        </view>
      </view>
      <view class="recommend-btn" bindtap="startCourse" data-id="c1">
        <mp-icon name="play_arrow" size="20" color="#fff" />
        <text class="recommend-btn-text">立即开始</text>
      </view>
    </view>
  </view>

  <!-- 全部课程 -->
  <text class="section-label">全部课程</text>
  <view class="course-list">
    <view
      wx:for="{{courses}}"
      wx:key="id"
      class="course-card"
    >
      <!-- 渐变 Banner -->
      <view class="course-banner course-banner-bg{{item.bg}}">
        <view class="banner-deco-circle"></view>
        <view class="course-banner-icon-wrap">
          <mp-icon name="{{item.icon}}" size="44" color="rgba(255,255,255,0.9)" />
        </view>
        <view class="difficulty-badge difficulty-badge-{{item.level === '初级' ? 'beginner' : 'intermediate'}}">
          <text class="difficulty-badge-text">{{item.level}}</text>
        </view>
      </view>

      <!-- 卡片内容 -->
      <view class="course-body">
        <text class="course-name font-headline">{{item.name}}</text>
        <text class="course-desc">{{item.desc}}</text>

        <!-- 元信息标签 -->
        <view class="course-meta">
          <view class="meta-tag">
            <mp-icon name="calendar_month" size="14" color="#8f8779" />
            <text class="meta-tag-text">{{item.duration}}</text>
          </view>
          <view class="meta-tag">
            <mp-icon name="analytics" size="14" color="#8f8779" />
            <text class="meta-tag-text">{{item.moves}}个动作</text>
          </view>
          <view class="meta-tag">
            <mp-icon name="trending_up" size="14" color="#8f8779" />
            <text class="meta-tag-text">{{item.level}}</text>
          </view>
        </view>

        <!-- 开始按钮 -->
        <view class="start-btn" bindtap="startCourse" data-id="{{item.id}}">
          <mp-icon name="play_arrow" size="20" color="#f7f5f0" />
          <text class="start-btn-text">开始训练</text>
        </view>
      </view>
    </view>
  </view>

  <view style="height: 140rpx"></view>
</view>
