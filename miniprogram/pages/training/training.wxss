.page {
  background: #f7f5f0;
  min-height: 100vh;
  padding: 40rpx 40rpx 0;
  box-sizing: border-box;
}

/* ── 页面 Header ── */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
  padding-top: 56rpx;
}
.header-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.header-title {
  font-size: 52rpx;
  color: #2b2720;
  font-weight: 300;
  line-height: 1.1;
}
.header-subtitle {
  font-size: 24rpx;
  color: #8f8779;
}
.header-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ── 筛选 Tabs ── */
/* ── 场景切换 ── */
.scene-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}
.scene-chip {
  flex: 1;
  padding: 18rpx 0;
  border-radius: 999rpx;
  background: #f0ede8;
  display: flex;
  align-items: center;
  justify-content: center;
}
.scene-chip-active {
  background: #2b2720;
}
.scene-chip-text {
  font-size: 27rpx;
  font-weight: 600;
  color: #8f8779;
}
.scene-chip-active .scene-chip-text {
  color: #ffffff;
}

.scene-empty {
  padding: 60rpx 40rpx;
  text-align: center;
}
.scene-empty-text {
  font-size: 27rpx;
  color: #bbb4ac;
}

.filter-scroll {
  width: 100%;
  margin-bottom: 36rpx;
  white-space: nowrap;
}
.filter-row {
  display: flex;
  gap: 16rpx;
  padding: 4rpx 2rpx;
}
.filter-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 36rpx;
  border-radius: 60rpx;
  background: #ffffff;
  flex-shrink: 0;
}
.filter-tab-active {
  background: #2b2720;
}
.filter-tab-text {
  font-size: 26rpx;
  color: #8f8779;
}
.filter-tab-text-active {
  color: #f7f5f0;
}

/* ── 今日推荐 ── */
.section-label {
  font-size: 22rpx;
  color: #8f8779;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  margin-bottom: 20rpx;
  display: block;
}
.recommend-card {
  background: #2b2720;
  border-radius: 40rpx;
  overflow: hidden;
  margin-bottom: 44rpx;
  position: relative;
}
.recommend-banner {
  height: 180rpx;
  background: linear-gradient(135deg, #c08a7d, #8f6a60);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}
.recommend-banner-deco {
  position: absolute;
  left: -60rpx;
  bottom: -60rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.08);
}
.recommend-tag {
  position: absolute;
  top: 20rpx;
  left: 24rpx;
  background: rgba(255,255,255,0.25);
  border-radius: 30rpx;
  padding: 8rpx 22rpx;
}
.recommend-tag-text {
  font-size: 20rpx;
  color: #fff;
  letter-spacing: 1rpx;
}
.recommend-icon-wrap {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}
.recommend-body {
  padding: 28rpx 36rpx 36rpx;
}
.recommend-name {
  display: block;
  font-size: 40rpx;
  color: #f7f5f0;
  font-weight: 300;
  margin-bottom: 8rpx;
}
.recommend-desc {
  display: block;
  font-size: 24rpx;
  color: #8f8779;
  margin-bottom: 28rpx;
}
.recommend-meta {
  display: flex;
  gap: 14rpx;
  margin-bottom: 32rpx;
  flex-wrap: wrap;
}
.recommend-meta-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255,255,255,0.08);
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
}
.recommend-meta-text {
  font-size: 22rpx;
  color: #a89f90;
}
.recommend-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #c08a7d;
  border-radius: 60rpx;
  height: 96rpx;
}
.recommend-btn-text {
  font-size: 30rpx;
  color: #fff;
  letter-spacing: 2rpx;
}

/* ── 课程卡片列表 ── */
.course-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}
.course-card {
  background: #ffffff;
  border-radius: 40rpx;
  overflow: hidden;
}

/* ── Banner 渐变区 ── */
.course-banner {
  height: 200rpx;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}
.course-banner-bg1 {
  background: linear-gradient(135deg, #e9e2d4, #a89f90);
}
.course-banner-bg2 {
  background: linear-gradient(135deg, #dde3da, #8fa88a);
}
.course-banner-bg3 {
  background: linear-gradient(135deg, #e8e0eb, #a090b8);
}
.banner-deco-circle {
  position: absolute;
  right: -80rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
}
.course-banner-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}
.difficulty-badge {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  padding: 8rpx 22rpx;
  border-radius: 30rpx;
}
.difficulty-badge-beginner {
  background: rgba(255,255,255,0.55);
}
.difficulty-badge-intermediate {
  background: rgba(192,138,125,0.35);
}
.difficulty-badge-text {
  font-size: 20rpx;
  color: #2b2720;
}

/* ── 卡片内容 ── */
.course-body {
  padding: 32rpx 36rpx 36rpx;
}
.course-name {
  display: block;
  font-size: 40rpx;
  color: #2b2720;
  font-weight: 300;
  margin-bottom: 10rpx;
  line-height: 1.2;
}
.course-desc {
  display: block;
  font-size: 24rpx;
  color: #8f8779;
  margin-bottom: 28rpx;
}

/* ── 元信息标签 ── */
.course-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 32rpx;
}
.meta-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #f4f1ec;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
}
.meta-tag-text {
  font-size: 22rpx;
  color: #6e675b;
}

/* ── 开始训练按钮 ── */
.start-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #2b2720;
  border-radius: 60rpx;
  height: 96rpx;
}
.start-btn-text {
  font-size: 30rpx;
  color: #f7f5f0;
  letter-spacing: 2rpx;
}

/* ── 顶部 Tab ── */
.top-tabs {
  display: flex;
  gap: 0;
  margin-bottom: 28rpx;
  background: #ede9e1;
  border-radius: 48rpx;
  padding: 8rpx;
}
.top-tab {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  transition: background 0.2s;
}
.top-tab-active {
  background: #2b2720;
}
.top-tab-text {
  font-size: 28rpx;
  color: #8f8779;
  letter-spacing: 2rpx;
}
.top-tab-active .top-tab-text {
  color: #f7f5f0;
}

/* ── 课程数量标签 ── */
.section-label {
  display: block;
  font-size: 24rpx;
  color: #8f8779;
  letter-spacing: 2rpx;
  margin-bottom: 24rpx;
  margin-top: 8rpx;
}

/* ── 循证徽章 ── */
.evidence-badge {
  position: absolute;
  bottom: 20rpx;
  right: 24rpx;
  background: rgba(255,255,255,0.35);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}
.evidence-badge-text {
  font-size: 18rpx;
  color: #2b2720;
  opacity: 0.85;
}

/* ── banner bg 4,5,6 ── */
.course-banner-bg4 {
  background: linear-gradient(135deg, #e2ddd5, #9b9080);
}
.course-banner-bg5 {
  background: linear-gradient(135deg, #d9e4de, #7a9e8a);
}
.course-banner-bg6 {
  background: linear-gradient(135deg, #e4dbd3, #b89080);
}

/* ── difficulty advanced ── */
.difficulty-badge-advanced {
  background: rgba(120,80,60,0.3);
}

/* ── 计划卡片 ── */
.program-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 48rpx;
}
.program-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 36rpx;
  display: flex;
  align-items: center;
  gap: 32rpx;
}
.program-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.program-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.program-name {
  font-size: 36rpx;
  color: #2b2720;
  font-weight: 300;
}
.program-desc {
  font-size: 22rpx;
  color: #8f8779;
  line-height: 1.5;
}
.program-meta {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-top: 8rpx;
}
.program-meta-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.program-meta-text {
  font-size: 20rpx;
  color: #8f8779;
}
.program-arrow {
  flex-shrink: 0;
}

/* ── 年度规划卡片 ── */
.annual-plan-card {
  background: #2b2720;
  border-radius: 32rpx;
  padding: 44rpx;
  margin-bottom: 40rpx;
}
.annual-plan-title {
  display: block;
  font-size: 36rpx;
  color: #f7f5f0;
  font-weight: 300;
  margin-bottom: 36rpx;
  letter-spacing: 2rpx;
}
.annual-plan-phases {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}
.phase-item {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}
.phase-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 8rpx;
}
.phase-dot-1 { background: #c08a7d; }
.phase-dot-2 { background: #8fa88a; }
.phase-dot-3 { background: #a090b8; }
.phase-dot-4 { background: #c4beb4; }
.phase-content {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.phase-label {
  font-size: 26rpx;
  color: #f7f5f0;
  font-weight: 400;
}
.phase-desc {
  font-size: 22rpx;
  color: #8f8779;
  line-height: 1.5;
}
